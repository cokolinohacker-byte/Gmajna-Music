{
  "name": "gmajna-music",
  "productName": "Gmajna Music",
  "version": "1.2.2",
  "description": "Gmajna Music",
  "author": "Gmajna",
  "repository": {
    "type": "git",
    "url": "https://github.com/cokolinohacker-byte/gmajna-music.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:unpacked": "npm run dist:unpacked && start \"\" \"dist\\win-unpacked\\Gmajna Music.exe\"",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:unpacked": "electron-builder --win --dir",
    "dist:release": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.gmajna.music",
    "files": [
      "main.js",
      "preload.js",
      "assets/gmajna-logo.png",
      "assets/gmajna-logo-gold.png",
      "assets/gmajna-logo-blue.png",
      "assets/gmajna-logo-purple.png",
      "assets/gmajna-logo.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/gmajna-logo.ico",
      "target": "nsis",
      "artifactName": "Gmajna-Music-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "cokolinohacker-byte",
      "repo": "gmajna-music",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "*",
    "electron-updater": "^6.6.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
